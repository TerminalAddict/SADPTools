/bin/
/.cache/
__pycache__/
/frontend/node_modules/
/frontend/dist/*
!/frontend/dist/.gitkeep
/*.syso
/.task/
*.log
*.test
*.test.exe
coverage.out
*.sqlite
*.sqlite-wal
*.sqlite-shm
